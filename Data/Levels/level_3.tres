[sub_resource type="Resource" id="Room_note_creatures"]
script = ExtResource("2_room")
Coord = Vector2i(-2, 0)
Mineral = 2
Loot = 4
NoteText = "\"Mientras más profundo, más oro... y más criaturas. No es casualidad: lo que sea que vive aquí abajo se alimenta del mineral, y nos cambia a nosotros también.\""

[sub_resource type="Resource" id="Room_note_revelation"]
script = ExtResource("2_room")
Coord = Vector2i(-1, -1)
Loot = 4
NoteText = "\"Lo encontré. En el fondo hay una grieta que respira, y una luz que no es de este mundo. Fue ella la que abrió los agujeros en los campos para traernos: nos necesita para cavar. Si alguien lee esto, la salida está al noroeste, detrás de la roca madre. No dejes que te convierta.\""

