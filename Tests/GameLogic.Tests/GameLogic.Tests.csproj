<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GameLogic.Tests</RootNamespace>
    <!-- Sin el .exe lanzador: con un SDK más nuevo (ej. .NET 10) el SDK
         intentaría bajar el "apphost" de .NET 8 desde NuGet, y NuGet.Config
         tiene las fuentes vacías a propósito. "dotnet run" sigue funcionando. -->
    <UseAppHost>false</UseAppHost>
    <!-- A propósito SIN paquetes NuGet (nada de xUnit/NUnit): así
         "dotnet run" compila y corre sin necesitar red, y sin arrastrar el
         SDK de Godot (que sí hace falta para el proyecto principal). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Se compilan directo los archivos del juego que NO dependen de
         GodotSharp, sin referenciar el .csproj de Godot completo. -->
    <Compile Include="../../World/Rooms/RoomMath.cs" Link="RoomMath.cs" />
    <Compile Include="../../Player/FallDamage.cs" Link="FallDamage.cs" />
    <Compile Include="../../Shared/CombatRules.cs" Link="CombatRules.cs" />
    <Compile Include="../../Systems/MapMemory.cs" Link="MapMemory.cs" />
    <Compile Include="../../World/Rooms/RoomMineralTable.cs" Link="RoomMineralTable.cs" />
    <Compile Include="../../World/Blocks/MineralType.cs" Link="MineralType.cs" />
    <Compile Include="../../Systems/WorldSaveData.cs" Link="WorldSaveData.cs" />
    <Compile Include="../../Systems/WorldSaveState.cs" Link="WorldSaveState.cs" />
    <Compile Include="../../World/Blocks/ToolTier.cs" Link="ToolTier.cs" />
    <Compile Include="../../Systems/ItemCatalog.cs" Link="ItemCatalog.cs" />
    <Compile Include="../../World/Props/ChestLoot.cs" Link="ChestLoot.cs" />
    <Compile Include="../../World/Rooms/ExitHint.cs" Link="ExitHint.cs" />
  </ItemGroup>

</Project>
