<?xml version="1.0" encoding="utf-8"?>
<!--
  Este proyecto de tests no usa ningún paquete NuGet a propósito (ver el
  comentario en GameLogic.Tests.csproj), así que no necesita ninguna fuente:
  "clear" evita que intente salir a internet a resolverlas, lo que además lo
  hace más rápido y confiable en CI o en redes restringidas.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
